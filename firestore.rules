rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if user is the admin (Diego)
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == 'diegoferrandezsempere@gmail.com';
    }
    
    // Instances collection
    match /instances/{instanceId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      
      // Costs subcollection
      match /costs/{costId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
      
      // Config files subcollection
      match /config/{configId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }
    
    // LLM Providers collection
    match /llmProviders/{providerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Cron Jobs collection
    match /cronJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
